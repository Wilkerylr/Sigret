# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
# Puerto del servidor Express (Render lo inyecta automáticamente en producción)
PORT=3001
# Origen permitido por CORS (en producción: URL del frontend en Netlify, separada por comas si hay varios)
CORS_ORIGIN=http://localhost:5173

# ==========================================
# SUPABASE (PostgreSQL en la nube)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publishable (anon) de Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXX
# Clave secreta con permisos totales (ignora RLS). Solo en el backend, nunca exponerla en el frontend
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXX

# ==========================================
# SEGURIDAD
# ==========================================
# Clave para firmar JWT. OBLIGATORIA, mínimo 16 caracteres.
# Generar una vez con: openssl rand -hex 32
# IMPORTANTE: debe ser un valor FIJO (no regenerar entre deploys) para no cerrar las sesiones activas
JWT_SECRET=genera-un-secreto-fijo-de-32-bytes-en-hex
# Tiempo de expiración del token (por defecto 8h). El frontend lo renueva antes de expirar.
JWT_EXPIRES_IN=8h

# ==========================================
# LOGGING
# ==========================================
# Nivel de logs: trace, debug, info, warn, error, fatal o silent.
# Por defecto: debug en desarrollo, info en producción y silent en tests.
LOG_LEVEL=debug

# ==========================================
# BACKUPS Y SEED (scripts operativos)
# ==========================================
# Cadena de conexión directa de Supabase para `npm run backup` (NO la URL de la API).
# Ejemplo: postgresql://postgres.<ref>:<password>@<host>:5432/postgres?sslmode=require
# SUPABASE_DB_URL=
# Carpeta de salida de los backups (por defecto backend/backups)
# BACKUP_DIR=./backups

# Datos del administrador inicial para `npm run seed:admin`.
# No los dejes escritos con la contraseña real en archivos versionados.
# ADMIN_EMAIL=admin@tu-dominio.com
# ADMIN_PASSWORD=
# ADMIN_NOMBRE=Administrador
# ADMIN_APELLIDO=SGRT
# ADMIN_ROL_ID=1
# ADMIN_PERMISOS=
# ADMIN_RESET_PASSWORD=false
