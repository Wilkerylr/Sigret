# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
# Puerto del servidor Express (Render lo inyecta automáticamente en producción)
PORT=3001
# Origen permitido por CORS (en producción: URL del frontend en Netlify, separada por comas si hay varios)
CORS_ORIGIN=http://localhost:5173

# ==========================================
# SUPABASE (PostgreSQL en la nube)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publishable (anon) de Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXX
# Clave secreta con permisos totales (ignora RLS). Solo en el backend, nunca exponerla en el frontend
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXX

# ==========================================
# SEGURIDAD
# ==========================================
# Clave para firmar JWT. OBLIGATORIA, mínimo 16 caracteres.
# Generar una vez con: openssl rand -hex 32
# IMPORTANTE: debe ser un valor FIJO (no regenerar entre deploys) para no cerrar las sesiones activas
JWT_SECRET=genera-un-secreto-fijo-de-32-bytes-en-hex
